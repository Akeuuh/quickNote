{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickNote",
  "version": "../package.json",
  "identifier": "com.aleclercq.quicknote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickNote",
        "width": 1024,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MzExQkVGQjE2MTc4NEIKUldSTGVHR3g3eHN4V2QrSTBQaUxPZEUrSkJSaHN6bVBpblcvYXpCREJBcHprTmt1VnZpakhPOE8K",
      "endpoints": ["https://github.com/Akeuuh/quickNote/releases/latest/download/latest.json"]
    }
  }
}
